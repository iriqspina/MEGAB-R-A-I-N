# GerenteNeuron — copie para .env e preencha as chaves que você usar.
# O arquivo .env NUNCA é versionado no Git.

# OpenAI
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic (Claude)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Google Gemini
# GEMINI_API_KEY="..."
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

# Moonshot (Kimi)
# MOONSHOT_API_KEY="..."
# MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"

# Ollama local — não precisa de key
# OLLAMA_BASE_URL="http://localhost:11434"

# Modo padrão: auto (escolhe modelo) ou manual (você escolhe)
GERENTENEURON_MODO=auto
