# GerenteNeuron — configuração local (não versionar).
# Caminho legado: prefira o cofre (mb-vault.py add CHAVE valor).
# Aqui a chave fica em TEXTO PURO no disco.

# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="..."
# MOONSHOT_API_KEY="..."

# Endpoints alternativos (só se você usa proxy/região diferente)
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
# MOONSHOT_BASE_URL="https://api.moonshot.ai/v1"
# OLLAMA_BASE_URL="http://localhost:11434"

# Modo padrão: auto (roteador escolhe) ou manual (você escolhe)
GERENTENEURON_MODO=auto
